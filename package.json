{
  "name": "3draft",
  "version": "26.11.11032",
  "description": "Minimalist AI first 3D engine: palette-texture, WASM core, WebGPU/WebGL2 renderer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "APP.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/build.mjs && node --test \"dist/**/*.test.js\" \"examples/**/*.test.js\" \"mcp/**/*.test.js\" \"scripts/**/*.test.js\"",
    "mcp": "node mcp/server.js",
    "example": "node examples/table.js",
    "bridge": "node examples/bridge.js",
    "kernel": "node scripts/build-kernel.mjs",
    "app": "node app/serve.js",
    "bump": "node scripts/bump.js",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check"
  },
  "keywords": [
    "3d",
    "svg",
    "webgpu",
    "webgl2",
    "wasm",
    "hexaw",
    "minimalist",
    "engine",
    "ai-first",
    "mcp"
  ],
  "author": {
    "name": "Vívó Péter",
    "url": "https://github.com/Pengeszikra"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pengeszikra/3Draft.git"
  },
  "bugs": {
    "url": "https://github.com/Pengeszikra/3Draft/issues"
  },
  "homepage": "https://github.com/Pengeszikra/3Draft#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^22.0.0"
  }
}
